[sub_resource type="BTAction" id="BTAction_select"]
script = ExtResource("2_select")

[sub_resource type="BTCondition" id="BTCondition_melee"]
script = ExtResource("3_melee")

[sub_resource type="BTAction" id="BTAction_attack"]
script = ExtResource("4_attack")

[sub_resource type="BTSequence" id="BTSequence_attack"]
