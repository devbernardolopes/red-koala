[gd_resource type="BehaviorTree" format=3 uid="uid://cx36usd8yhwq4"]

[ext_resource type="Script" uid="uid://cbamwna44k6ok" path="res://scripts/ai/tasks/target_in_melee_range.gd" id="2_melee"]
[ext_resource type="Script" uid="uid://dui7a8ngv0lli" path="res://scripts/ai/tasks/attack_target.gd" id="3_attack"]
