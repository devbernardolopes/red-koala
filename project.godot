; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Red Koala"
run/main_scene="uid://cknfyomnqipkc"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://r8fc8q2r20et"

[autoload]

GameManager="*uid://fmh1yqm4ohc8"
MusicPlayer="*uid://bo0j55y6gx1u8"
AudioManager="*uid://ch1je27gt2ghb"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "yellow",
"res://autoloaders/": "blue",
"res://resources/": "orange",
"res://scenes/": "red",
"res://scripts/": "green",
"res://shaders/": "pink"
}

